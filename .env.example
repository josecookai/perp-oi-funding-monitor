# Copy to .env and edit. Every value below is optional; defaults shown.

# Paths (relative to the repo root)
PERP_MONITOR_DB=data/monitor.db
PERP_MONITOR_REPORTS_DIR=reports
PERP_MONITOR_ALLOWLIST=assets/stocks_allowlist.txt
PERP_MONITOR_OVERRIDES=assets/symbol_overrides.toml
PERP_MONITOR_DENYLIST=assets/crypto_denylist.txt

# Hyperliquid HIP-3 dexes to scan (comma separated). The main crypto dex is never read.
HL_DEXES=xyz

# Expected time between runs; windows outside +/- tolerance are flagged in the report.
EXPECTED_WINDOW_HOURS=8
WINDOW_TOLERANCE_HOURS=1
TOP_N=10

# On the first run, fill Binance's previous OI from /futures/data/openInterestHist.
BINANCE_BACKFILL=1

# Endpoints
BINANCE_BASE_URL=https://fapi.binance.com
HL_INFO_URL=https://api.hyperliquid.xyz/info
HTTP_TIMEOUT_SECONDS=15

# Telegram (leave TELEGRAM_CHAT_ID empty to disable).
# Token comes from TELEGRAM_BOT_TOKEN, or else from the dotenv-style file TELEGRAM_TOKEN_FILE.
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN_FILE=
